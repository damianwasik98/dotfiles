# default layout (can be bsp, stack or float)
# using float since yabai is only used here for moving windows between spaces/displays
yabai -m config layout float

# padding
yabai -m config top_padding 12
yabai -m config bottom_padding 12
yabai -m config left_padding 12
yabai -m config right_padding 12
yabai -m config window_gap 12

# mouse settings

# center mouse on window with focus
yabai -m config mouse_follows_focus on

# disable specific apps
yabai -m rule --add app="^Ustawienia systemowe$" manage=off
yabai -m rule --add app="^Kalkulator$" manage=off
yabai -m rule --add app="^Raycast$" manage=off
#yabai -m rule --add app="^1Password$" manage=off
yabai -m rule --add app="^Numi$" manage=off
